<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- These repositories intentionally retain container-managed resource proxies. -->
    <Match>
        <Class name="hello.helloSpring.repository.JdbcMemberRepository"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="hello.helloSpring.repository.JpaMemberRepository"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
